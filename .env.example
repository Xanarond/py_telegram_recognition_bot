# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telegram_bot_users
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=bot_password

# MongoDB Configuration
MONGODB_URL=mongodb://admin:admin_password@mongodb:27017/telegram_bot_analytics?authSource=admin
MONGODB_DATABASE=telegram_bot_analytics

# Application Settings
ENABLE_DATA_MIGRATION=true
LOG_LEVEL=INFO

# Admin Panel Access (optional)
ADMINER_PORT=8080
MONGO_EXPRESS_PORT=8081 